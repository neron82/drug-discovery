# Drug Discovery Platform — environment
# Copy to .env and adjust. Never commit real secrets.

# Storage
DATA_DIR=./data
SQLITE_PATH=./data/research.db
LOG_DIR=./logs
ARTIFACT_DIR=./data/artifacts

# Local LLM (OpenAI-compatible, multimodal w/ vision). Leave empty to autodetect from config.yaml.
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL_ID=Qwen3.8-Flash-Next-exl3
LLM_API_KEY=
LLM_TEMPERATURE=0.2

# Embeddings (bge-m3 via llama.cpp, OpenAI-compatible)
EMB_BASE_URL=http://127.0.0.1:7777/v1
EMB_MODEL_ID=bge-m3
EMB_ENABLED=true

# API / UI
API_HOST=0.0.0.0
API_PORT=8020

# NCBI E-utilities (optional API key raises rate limits; leave blank for 3 req/s)
NCBI_API_KEY=
# Mail used for NCBI E-utilities etiquette
NCBI_MAIL=research@localhost
